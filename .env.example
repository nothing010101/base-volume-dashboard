# Alchemy RPC endpoint for Base mainnet (required).
# Create one at https://dashboard.alchemy.com -> Apps -> Base Mainnet -> HTTPS URL
ALCHEMY_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Wallet that the bot trades from (the one you want to monitor).
WALLET_ADDRESS=0x29d02e247f345a7f882BF67911407f465FFE2944

# Optional: only count swaps for this token.
# Leave empty to count every token the wallet trades.
TOKEN_ADDRESS=
